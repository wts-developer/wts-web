# Copy this file to .env (same directory) and fill in your values.
# .env is gitignored; never commit the real token.

# From https://www.notion.so/my-integrations -> your integration -> secret
NOTION_TOKEN=secret_paste_yours_here

# The 32-hex-character tail of the parent page's URL (dashes are fine too)
NOTION_PARENT_PAGE_ID=paste_page_id_here
